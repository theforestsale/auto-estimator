# Copy this file to .env and fill in values.

# ============ AI PROVIDER (Groq free tier) ============
# Free key at https://console.groq.com/keys - no credit card required.
GROQ_API_KEY=
AI_MODEL=openai/gpt-oss-120b
AI_BASE_URL=https://api.groq.com/openai/v1

# ============ APP ============
# Random secret:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change_this_to_a_random_secret
FREE_PLAN_QUOTA=3
REQUEST_TIMEOUT=60

# ============ SECURITY ============
CSRF_ENABLED=1
RATE_LIMIT_ENABLED=1
RATE_LIMIT_GENERATE=10
RATE_LIMIT_AUTH=30
# Manual activation (no webhook needed): /admin page. Pick a random passphrase.
# Leave empty to hide the /admin page entirely.
ADMIN_KEY=

# ============ SHOP DETAILS (shown on the estimate PDF) ============
SHOP_NAME=Your Auto Shop
SHOP_PHONE=
SHOP_ADDRESS=
SHOP_EMAIL=

# ============ DEFAULT PRICING ============
DEFAULT_LABOR_RATE=95
DEFAULT_TAX_RATE=8.0

# ============ PAYMENTS ============
# Paste your Lemon Squeezy / Stripe / Gumroad checkout link here so the
# "Upgrade" button redirects to the real payment page.
PRO_CHECKOUT_URL=

# Shared secret for verifying billing webhooks (HMAC-SHA256).
WEBHOOK_SECRET=